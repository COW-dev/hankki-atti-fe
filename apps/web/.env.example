# 백엔드 API 주소 (로컬 기본값: http://localhost:8080). API_PROXY_TARGET이 있으면 쓰지 않는다
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 메인 사이트 주소. 도우미·관리자 화면은 이 주소 앞에 helper. / admin. 을 붙인다 (로컬 기본값: http://localhost:3000)
# Vercel: https://atti.bluerack.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# /api/*를 넘길 백엔드 주소. 서버 전용이고 빌드 시점에 고정된다. 있으면 브라우저는 같은 도메인의 /api를 부른다
# 로컬에서는 넣지 않는다. Vercel: http://api.atti.bluerack.org (끝에 /api를 붙이지 않는다)
# API_PROXY_TARGET=
